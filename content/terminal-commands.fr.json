      ]
    },
    "about": { "desc": "Ouvre l'app À propos", "action": "open:about" },
    "projects": { "desc": "Liste les projets", "action": "projects" },
    "skills": {
      "desc": "Mes compétences techniques",
      "output": [
        "Langages     : Python, JavaScript, Dart, SQL",
        "Frameworks   : FastAPI, Flask, Next.js / React, Flutter",
        "Infra/DevOps : Docker, Proxmox, VPS, Nextcloud, SQLite",
        "IA           : API Anthropic (Claude), intégration & automatisation"
      ]
    },
    "contact": {
      "desc": "Mes moyens de contact",
      "output": [
        "Email    : nidalyassami@gmail.com",
        "LinkedIn : https://linkedin.com/in/nidal-lyassami",
        "GitHub   : https://github.com/k-aka-shi"
      ]
    },
    "cv": { "desc": "Ouvre / télécharge le CV", "action": "cv" },
    "neofetch": { "desc": "Specs du système", "action": "neofetch" },
    "clear": { "desc": "Efface l'écran", "action": "clear" },
    "ls projects/": { "alias": "projects", "hidden": true },
    "ls": { "alias": "projects", "hidden": true },
    "sudo make-coffee": {
      "hidden": true,
      "output": [
        "Permission denied: pas encore de café configuré sur ce système ☕"
