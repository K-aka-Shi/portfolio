    "cat outer_wilds.txt": {
      "hidden": true,
      "output": [
        "« 14 minutes... puis tout recommence. »",
        "Clin d'œil à Outer Wilds & Firewatch : explorer pour comprendre un système.",
        "Ici, le système à explorer, c'est ce portfolio. Bonne boucle temporelle."
      ]
